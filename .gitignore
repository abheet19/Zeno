# --- secrets: never, under any circumstance ---
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
ssh
ssh.pub
credentials*
secrets*
*.token

# --- private design evidence: owner-supplied, unverified rights ---
# Source videos and derived frames must never enter version control.
evidence/
*.mp4
*.mov
framehash.txt
scene.txt
frames.csv

# --- employer-derived material: keep out of a personal repo ---
docs/03a-context-bootstrap-report.md
docs/03b-existing-knowledge-systems-report.md

# --- noise ---
.DS_Store
node_modules/
__pycache__/
*.pyc
dist/
build/
.venv/

# --- runtime state: the receipt ledger and the demo sandbox ---
.zeno/
.daemon.log
proposer.token
keys/
receipt-key.pem
receipt-key.pub.pem
dist-exe/

# ---- runtime + test debris -------------------------------------------------
# The daemon's workspace is .zeno by default, but every test run and every
# parallel agent uses its OWN (the workspace lock forbids sharing one). Each of
# those holds a PRIVATE SIGNING KEY and a live proposer token, so the glob
# matters more than the tidiness: .zeno alone was not enough.
.zeno*/
*.log
.*.log
.probe-*.json
dist-exe/
dist-app/

# ---- installed third-party skills -------------------------------------------
# `npx skills add` fetches these; skills-lock.json records exactly which, so the
# tree is reproducible without committing 800+ files of someone else's prose.
# .claude/skills is the same content again as symlinks, so it goes too.
.agents/skills/
.claude/skills/

# ---- demo recording scratch -------------------------------------------------
# tools/record-demos.mjs writes its PNG captures and frame manifests here. The
# GIFs it assembles from them are committed under docs/demos; the frames are not.
.demo-scratch/

# a stray build backup
**/dist.bak/

# ---- vendored editor: generated by `npm run vendor:monaco`, never authored ---
# Monaco is a root devDependency and tools/vendor-monaco.mjs copies its prebuilt
# min/vs bundle here so the daemon serves the editor from loopback with no CDN.
# 15 MB of someone else's minified output is a build artefact, not source.
packages/daemon/public/vendor/

# ---- vendored glass tokens: generated by scripts/sync-glass.mjs, never authored ---
# @abheet19/glass is a real local file: dependency (packages/daemon/package.json);
# this is scripts/sync-glass.mjs's byte-identical copy of its tokens.css, made
# servable to the static UI with no bundler and no CDN. Build artefact, not source.
packages/daemon/public/glass/vendor/
