{
  "appId": "dev.abheet.zeno",
  "productName": "Zeno",
  "directories": {
    "output": "dist-app"
  },
  "files": [
    "packages/desktop/main.cjs",
    "packages/desktop/package.json",
    "package.json",
    "packages/desktop/speech.cjs",
    "packages/desktop/whisper.cjs",
    "packages/desktop/project.cjs",
    "packages/desktop/preload.cjs",
    "packages/desktop/lifecycle.cjs",
    "packages/desktop/zoom.cjs",
    "packages/desktop/meeting-presence.cjs",
    "packages/desktop/resources/icon.ico"
  ],
  "extraResources": [
    {
      "from": "packages/daemon/dist/src",
      "to": "daemon"
    },
    {
      "from": "packages/desktop/resources/daemon-package.json",
      "to": "daemon/package.json"
    },
    {
      "from": "packages/daemon/public",
      "to": "daemon/../../public"
    },
    {
      "from": "packages/assistant",
      "to": "node_modules/@abheet19/zeno-assistant",
      "filter": [
        "package.json",
        "dist/**/*"
      ]
    },
    {
      "from": "packages/counsel",
      "to": "node_modules/@abheet19/zeno-counsel",
      "filter": [
        "package.json",
        "dist/**/*"
      ]
    },
    {
      "from": "packages/forge",
      "to": "node_modules/@abheet19/zeno-forge",
      "filter": [
        "package.json",
        "dist/**/*"
      ]
    },
    {
      "from": "packages/browse",
      "to": "node_modules/@abheet19/zeno-browse",
      "filter": [
        "package.json",
        "dist/**/*",
        "session-main.cjs"
      ]
    },
    {
      "from": "packages/chrome-bridge",
      "to": "node_modules/@abheet19/zeno-chrome",
      "filter": [
        "package.json",
        "dist/**/*"
      ]
    },
    {
      "from": "packages/intake",
      "to": "node_modules/@abheet19/zeno-intake",
      "filter": [
        "package.json",
        "dist/**/*"
      ]
    },
    {
      "from": "packages/kernel",
      "to": "node_modules/@abheet19/zeno-kernel",
      "filter": [
        "package.json",
        "dist/**/*"
      ]
    },
    {
      "from": "packages/mesh",
      "to": "node_modules/@abheet19/zeno-mesh",
      "filter": [
        "package.json",
        "dist/**/*"
      ]
    },
    {
      "from": "packages/sanitizer",
      "to": "node_modules/@abheet19/zeno-sanitizer",
      "filter": [
        "package.json",
        "dist/**/*"
      ]
    },
    {
      "from": "packages/skills",
      "to": "node_modules/@abheet19/zeno-skills",
      "filter": [
        "package.json",
        "dist/**/*"
      ]
    },
    {
      "from": "packages/vault",
      "to": "node_modules/@abheet19/zeno-vault",
      "filter": [
        "package.json",
        "dist/**/*"
      ]
    },
    {
      "from": "packages/desktop/windows-speech.ps1",
      "to": "speech/windows-speech.ps1"
    }
  ],
  "win": {
    "icon": "packages/desktop/resources/icon.ico",
    "target": [
      "portable",
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "Zeno",
    "artifactName": "Zeno-Setup-${version}-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "Zeno-${version}-${arch}-portable.${ext}"
  }
}
