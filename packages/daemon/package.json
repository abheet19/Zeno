{
  "name": "@abheet19/zeno-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zeno Command daemon \u2014 the loopback process boundary that makes L6 structural. An agent process physically cannot mint an approval.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/sync-glass.mjs",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "check": "npm run typecheck && npm run test && npm run test:glass && node scripts/sync-glass.mjs",
    "test:glass": "node --test \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "@abheet19/zeno-intake": "*",
    "@abheet19/zeno-kernel": "*",
    "@abheet19/zeno-vault": "*",
    "@abheet19/zeno-sanitizer": "*",
    "@abheet19/zeno-counsel": "*",
    "@abheet19/zeno-forge": "*",
    "@abheet19/zeno-browse": "*",
    "@abheet19/zeno-mesh": "*",
    "@abheet19/zeno-assistant": "*",
    "@abheet19/zeno-skills": "*"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "typescript": "^5.6.3"
  }
}
