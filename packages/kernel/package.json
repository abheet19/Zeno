{
  "name": "@abheet19/zeno-kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zeno slice P1-01 \u2014 deterministic Policy & Approval Kernel. Zero network, zero LLM.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsc && node --test --experimental-test-coverage --test-coverage-exclude=\"dist/test/**\" --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 \"dist/test/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm run test",
    "lint": "node scripts/lint.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "typescript": "^5.6.3"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  }
}
