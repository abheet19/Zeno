{
  "name": "@abheet19/zeno-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zeno Vault — governed local memory. Plain Markdown + frontmatter, cited recall, a morning brief. Opens in any text editor; nothing is locked in.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" } },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsc && node --test --experimental-test-coverage --test-coverage-exclude=\"dist/test/**\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 \"dist/test/*.test.js\"",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": { "@types/node": "^20.16.11", "typescript": "^5.6.3" }
}
